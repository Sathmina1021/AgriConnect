<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Address of the running Supplier.Service project (see its IIS Express port) -->
    <add key="ServiceUrl" value="http://localhost:5002/SupplierWS.asmx" />
    <!-- Must match the ApiKey in Supplier.Service\Web.config -->
    <add key="ApiKey" value="AGRI-SUPPLIER-KEY-2026" />
  </appSettings>
</configuration>
