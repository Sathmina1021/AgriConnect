<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!-- Database: change ONLY this string for your machine (e.g. .\SQLEXPRESS or (localdb)\MSSQLLocalDB). -->
  <connectionStrings>
    <add name="FarmerDb"
         connectionString="Data Source=desktop-kh5op4v\sqlexpress;Initial Catalog=AgriConnect_Farmer_SOC;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- true  = Supplier/Officer/Admin calls are mocked (standalone testing).
         false = call teammates' real SOAP services listed in <client> below. -->
    <add key="UseMockIntegrations" value="true" />
    <!-- Only used with mocks: the mock Agriculture Officer approves requests when the farmer clicks "Check approval status". -->
    <add key="MockOfficerAutoApprove" value="true" />
    <!-- Shared secret the Officer service must send when it calls ApplyOfficerDecision. Agree it with your team. -->
    <add key="IntegrationKey" value="agriconnect-demo-key" />
  </appSettings>

  <system.serviceModel>
    <services>
      <service name="Farmer.Service.FarmerService" behaviorConfiguration="FarmerServiceBehavior">
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8733/Design_Time_Addresses/AgriConnect/Farmer/" />
          </baseAddresses>
        </host>
        <!-- SOAP 1.1 endpoint (basicHttpBinding) used by the Windows Forms client -->
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="FarmerBasicBinding"
                  contract="Farmer.Contracts.IFarmerService" />
        <!-- Metadata exchange (lets Visual Studio read the contract) -->
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
    </services>

    <bindings>
      <basicHttpBinding>
        <binding name="FarmerBasicBinding" maxReceivedMessageSize="2097152"
                 openTimeout="00:00:15" sendTimeout="00:01:00" receiveTimeout="00:10:00">
          <security mode="None" />
        </binding>
      </basicHttpBinding>
    </bindings>

    <behaviors>
      <serviceBehaviors>
        <behavior name="FarmerServiceBehavior">
          <!-- Publishes the WSDL at  <baseAddress>?wsdl -->
          <serviceMetadata httpGetEnabled="true" />
          <!-- false: clients get our clean ServiceFault, never stack traces -->
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>

    <!-- Endpoints of the OTHER roles. Replace with your teammates' real addresses and set UseMockIntegrations=false. -->
    <client>
      <endpoint name="SupplierEndpoint" address="http://localhost:8733/Design_Time_Addresses/AgriConnect/Supplier/"
                binding="basicHttpBinding" contract="Farmer.Service.Integration.ISupplierRemote" />
      <endpoint name="OfficerEndpoint" address="http://localhost:8733/Design_Time_Addresses/AgriConnect/Officer/"
                binding="basicHttpBinding" contract="Farmer.Service.Integration.IOfficerRemote" />
      <endpoint name="AdminEndpoint" address="http://localhost:8733/Design_Time_Addresses/AgriConnect/Admin/"
                binding="basicHttpBinding" contract="Farmer.Service.Integration.IAdminRemote" />
    </client>
  </system.serviceModel>
</configuration>
