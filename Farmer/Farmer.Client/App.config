<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!-- Visual Studio fills in <system.serviceModel> here when you add the Service Reference
       (Add Service Reference -> http://localhost:8733/Design_Time_Addresses/AgriConnect/Farmer/ -> namespace FarmerServiceReference). -->
<system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="BasicHttpBinding_IFarmerService" />
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://localhost:8733/Design_Time_Addresses/AgriConnect/Farmer/"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IFarmerService"
                contract="FarmerServiceReference.IFarmerService" name="BasicHttpBinding_IFarmerService" />
        </client>
    </system.serviceModel>
</configuration>
