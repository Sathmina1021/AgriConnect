<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Every consumer must send this key in the SOAP header. Leave the value empty to switch the check off. -->
    <add key="ApiKey" value="AGRI-SUPPLIER-KEY-2026" />
  </appSettings>

  <connectionStrings>
    <!--
      Use the SAME server name you type in SSMS "Server name".
        LocalDB (comes with Visual Studio) : (localdb)\MSSQLLocalDB
        SQL Server Express                 : .\SQLEXPRESS
        Full SQL Server on this PC         : .   (or the computer name)
      The database AgriConnect_SupplierDB is created automatically on the first run.
    -->
    <add name="SupplierDb"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=AgriConnect_SupplierDB;Integrated Security=True;Connect Timeout=15;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
</configuration>
